  {
   "id": "director",
   "name": "Director film build",
   "summary": "A brief committed by the studio builds a whole film inside its money cap.",
   "doc": "docs/manual/workflows/director.md",
   "run": "Studio Create, Build (commits films/studio/<id>/brief.json; .github/workflows/film.yml)"
  },
  {
   "id": "films-render",
   "name": "Film render",
   "summary": "Renders a film folder on free runners and publishes to kino-films.",
   "doc": "docs/manual/workflows/films-render.md",
   "run": "Eouchi147/rc-render films.yml (workflow dispatch)"
  },
  {
   "id": "stills",
   "name": "Stills",
   "summary": "Renders chosen frames of a film folder.",
   "doc": "docs/manual/workflows/stills.md",
   "run": "Eouchi147/rc-render stills.yml"
  },
  {
   "id": "score",
   "name": "Free score engine",
   "summary": "Procedural music in code, no money.",
   "doc": "docs/manual/sound/score.md",
   "run": "python3 films/lib/score/remix.py <job>"
  },
  {
   "id": "music-fetch",
   "name": "Music fetch",
   "summary": "Fetches a public-domain recording with its licence record into release music.",
   "doc": "docs/manual/sound/music-fetch.md",
   "run": "Eouchi147/rc-render music-fetch.yml"
  }
 ],
